rules_version = '2';
// Forge – přístup jen pro dva povolené Google účty; každý vidí a mění jen svá data.
// Vše, co tu není výslovně povolené, je zakázané.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Musí odpovídat src/lib/access.js: FOUNDERS napevno + účty, které přidal admin (access/{email})
    function email() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && email() == 'tofbenka@gmail.com';
    }
    function allowed() {
      return email() in ['tofbenka@gmail.com', 'chiaralari24@gmail.com']
        || exists(/databases/$(database)/documents/access/$(email()));
    }

    // ——— Povolené účty (spravuje jen admin; každý si smí přečíst jen svůj záznam) ———
    match /access/{addr} {
      allow get: if signedIn() && (isAdmin() || email() == addr);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'name', 'addedAt'])
        && request.resource.data.email == addr
        && str(addr, 120)
        && str(request.resource.data.name, 60)
        && request.resource.data.addedAt is int;
      allow delete: if isAdmin();
    }
    function owner(uid) {
      return signedIn() && allowed() && request.auth.uid == uid;
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function num(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }
    function colorOrNull(v) {
      return v == null || (v is string && v.matches('^#[0-9a-fA-F]{6}$'));
    }
    function validLook(a) {
      return a is map && a.keys().hasOnly(['tint', 'strength', 'accent'])
        && colorOrNull(a.get('tint', null)) && colorOrNull(a.get('accent', null))
        && (!('strength' in a) || num(a.strength, 0, 100));
    }

    // ——— Odcvičené tréninky ———
    match /users/{uid}/workouts/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validWorkout(request.resource.data, id);
    }
    function validWorkout(d, id) {
      return d.keys().hasOnly(['id', 'templateId', 'name', 'group', 'variant', 'startedAt', 'finishedAt', 'exercises'])
        && d.keys().hasAll(['id', 'name', 'startedAt', 'finishedAt', 'exercises'])
        && d.id == id
        && str(d.name, 80)
        && (!('templateId' in d) || str(d.templateId, 60))
        && (!('group' in d) || str(d.group, 20))
        && (!('variant' in d) || str(d.variant, 40))
        && d.startedAt is int && d.finishedAt is int
        && d.finishedAt >= d.startedAt
        && d.finishedAt <= request.time.toMillis() + 86400000
        && d.exercises is list && d.exercises.size() > 0 && d.exercises.size() <= 40;
    }

    // ——— Osobní rekordy ———
    match /users/{uid}/prs/{key} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && key.size() <= 120 && validPr(request.resource.data);
    }
    function validPr(d) {
      return d.keys().hasOnly(['name', 'weight', 'reps', 'time', 'date'])
        && str(d.name, 80)
        && num(d.weight, 0, 500)
        && num(d.reps, 0, 200)
        && (!('time' in d) || num(d.time, 0, 600))
        && d.date is int;
    }

    // ——— Vlastní šablony ———
    match /users/{uid}/templates/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.id == id
        && str(request.resource.data.name, 80)
        && request.resource.data.exercises is list
        && request.resource.data.exercises.size() <= 40;
    }

    // ——— Nastavení: knihovna cviků, profil, upravené hlavní šablony ———
    match /users/{uid}/meta/{doc} {
      allow read: if owner(uid);
      allow delete: if false;
      allow create, update: if owner(uid) && (
        (doc == 'profile' && request.resource.data.keys().hasOnly(['id']) && request.resource.data.id in ['ppl', 'ul', 'fb', 'krystof', 'chiara'])
        || (doc == 'exercises' && request.resource.data.keys().hasOnly(['list', 'v']) && request.resource.data.list is list && request.resource.data.list.size() <= 1500)
        || (doc == 'main' && request.resource.data.keys().hasOnly(['own', 'krystof', 'chiara'])
            && (!('own' in request.resource.data) || (request.resource.data.own.groups is list && request.resource.data.own.templates is list
                && request.resource.data.own.groups.size() <= 12 && request.resource.data.own.templates.size() <= 40)))
        || (doc == 'settings' && request.resource.data.keys().hasOnly(['weeklyGoal', 'pinnedLifts', 'appearance'])
            && (!('appearance' in request.resource.data) || validLook(request.resource.data.appearance))
            && (!('weeklyGoal' in request.resource.data)
                || (request.resource.data.weeklyGoal is int && request.resource.data.weeklyGoal >= 1 && request.resource.data.weeklyGoal <= 7))
            && (!('pinnedLifts' in request.resource.data)
                || (request.resource.data.pinnedLifts is list && request.resource.data.pinnedLifts.size() <= 5)))
      );
    }
  }
}
